# Copy this file to .env and fill in your keys. Never commit .env to GitHub.
LANGSMITH_API_KEY=paste-your-langsmith-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=SupportPilot

# Model provider: google (Gemini) or azure (Azure OpenAI, course key)
PROVIDER=google
GOOGLE_API_KEY=paste-your-gemini-key-here
AZURE_OPENAI_API_KEY=paste-your-azure-key-here

# Optional
MODEL_NAME=gemini-3.5-flash
AGENT_VERSION=v2
